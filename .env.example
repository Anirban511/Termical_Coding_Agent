# LLM configuration (OpenAI-compatible endpoint)
# Examples:
# - OpenAI: FORGE_BASE_URL=https://api.openai.com/v1, FORGE_MODEL=gpt-4o-mini
# - Groq: FORGE_BASE_URL=https://api.groq.com/openai/v1, FORGE_MODEL=llama-3.3-70b-versatile
# - Local Ollama: FORGE_BASE_URL=http://localhost:11434/v1, FORGE_MODEL=qwen2.5-coder:7b
FORGE_BASE_URL=https://api.openai.com/v1
FORGE_API_KEY=your-api-key-here
FORGE_MODEL=gpt-4o-mini
